" ~/.config/nvim/init.vim

" ========== General Settings ==========
set number                  " Show line numbers
set relativenumber          " Relative line numbers (great for navigation)
set tabstop=4               " Tab width = 4 spaces
set shiftwidth=4            " Indent width = 4 spaces
set expandtab               " Use spaces instead of tabs
set smartindent             " Smart auto-indenting
set wrap                    " Wrap long lines (toggle with :set wrap!)
set termguicolors           " Enable true color
set cursorline              " Highlight current line
set mouse=a                 " Enable mouse support
set clipboard=unnamedplus   " Use system clipboard
set ignorecase              " Case-insensitive search
set smartcase               " ... unless you type uppercase
set hlsearch                " Highlight search results
set incsearch               " Incremental search
set hidden                  " Allow switching buffers without saving

" ========== Key Mappings ==========
let mapleader = " "         " Space as leader key
" Easier escape
inoremap jk <Esc>
" Save and quit
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>
nnoremap <leader>x :x<CR>
" Move between splits
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
" Resize splits
nnoremap <C-Left> :vertical resize -2<CR>
nnoremap <C-Right> :vertical resize +2<CR>
nnoremap <C-Up> :resize -2<CR>
nnoremap <C-Down> :resize +2<CR>

" ========== Plugin Management ==========
call plug#begin('~/.local/share/nvim/plugged')

" Color scheme
Plug 'catppuccin/nvim', { 'as': 'catppuccin' }

" Treesitter – better syntax highlighting and code understanding
Plug 'nvim-treesitter/nvim-treesitter', {'do': ':TSUpdate'}

" LSP support (Language Server Protocol)
Plug 'neovim/nvim-lspconfig'
Plug 'williamboman/mason.nvim'
Plug 'williamboman/mason-lspconfig.nvim'

" Autocompletion
Plug 'hrsh7th/nvim-cmp'
Plug 'hrsh7th/cmp-nvim-lsp'
Plug 'hrsh7th/cmp-buffer'
Plug 'hrsh7th/cmp-path'
Plug 'L3MON4D3/LuaSnip'
Plug 'saadparwaiz1/cmp_luasnip'

" Fuzzy finder (like fzf)
Plug 'nvim-telescope/telescope.nvim', { 'tag': '0.1.8' }
Plug 'nvim-lua/plenary.nvim'

" Git integration
Plug 'lewis6991/gitsigns.nvim'

" File explorer
Plug 'nvim-neo-tree/neo-tree.nvim', {'branch': 'v3.x'}
Plug 'nvim-lua/plenary.nvim'
Plug 'nvim-tree/nvim-web-devicons'
Plug 'MunifTanjim/nui.nvim'

call plug#end()

" ========== Plugin Configuration ==========
" Colorscheme
colorscheme catppuccin

" Treesitter
lua << EOF
require'nvim-treesitter.configs'.setup {
  ensure_installed = { "lua", "python", "javascript", "typescript", "rust", "go", "bash", "json", "yaml" },
  auto_install = true,
  highlight = { enable = true },
  indent = { enable = true },
}
EOF

" LSP setup (using Mason + lspconfig)
lua << EOF
require("mason").setup()
require("mason-lspconfig").setup({
  ensure_installed = { "lua_ls", "pyright", "tsserver", "rust_analyzer", "gopls", "bashls" },
  automatic_installation = true,
})

local lspconfig = require("lspconfig")
-- Use default setup for each LSP server (can be customised later)
lspconfig.lua_ls.setup{}
lspconfig.pyright.setup{}
lspconfig.tsserver.setup{}
lspconfig.rust_analyzer.setup{}
lspconfig.gopls.setup{}
lspconfig.bashls.setup{}
EOF

" Autocompletion
lua << EOF
local cmp = require'cmp'
cmp.setup({
  snippet = {
    expand = function(args)
      require('luasnip').lsp_expand(args.body)
    end,
  },
  mapping = cmp.mapping.preset.insert({
    ['<C-b>'] = cmp.mapping.scroll_docs(-4),
    ['<C-f>'] = cmp.mapping.scroll_docs(4),
    ['<C-Space>'] = cmp.mapping.complete(),
    ['<CR>'] = cmp.mapping.confirm({ select = true }),
    ['<Tab>'] = cmp.mapping(function(fallback)
      if cmp.visible() then
        cmp.select_next_item()
      else
        fallback()
      end
    end, { 'i', 's' }),
  }),
  sources = cmp.config.sources({
    { name = 'nvim_lsp' },
    { name = 'luasnip' },
    { name = 'buffer' },
    { name = 'path' },
  }),
})
EOF

" Telescope keymaps
nnoremap <leader>ff <cmd>Telescope find_files<CR>
nnoremap <leader>fg <cmd>Telescope live_grep<CR>
nnoremap <leader>fb <cmd>Telescope buffers<CR>
nnoremap <leader>fh <cmd>Telescope help_tags<CR>

" Gitsigns
lua << EOF
require('gitsigns').setup()
EOF

" Neo-tree (file explorer)
nnoremap <leader>e <cmd>Neotree toggle<CR>
